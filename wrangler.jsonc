{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "69e937de-6eab-438b-bdad-367b7657fb1f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5c7147a7bd7c43818775fe4734693de1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
